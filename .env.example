# Firebase service account (Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Web API key (Project settings > General), used server-side for password sign-in
FIREBASE_API_KEY=your_web_api_key
FIREBASE_STORAGE_BUCKET=your-firebase-project.firebasestorage.app
FIREBASE_DATABASE_ID=bumex
# ERP database (PostgreSQL, schema "erp", migrations in db/erp). Leave both empty and the ERP stays hidden.
# Locally: postgres://<you>@localhost:5432/bumex_erp, then `npm run erp:migrate`.
ERP_DATABASE_URL=
# Production uses Cloud SQL through Google's connector instead (see apphosting.yaml):
# ERP_CLOUDSQL_INSTANCE=bumex-one:europe-west4:bumex-erp-vanguard
# ERP_DATABASE_USER=bumex_app
# ERP_DATABASE_PASSWORD=
# ERP_DATABASE_NAME=bumex_erp
APP_URL=https://dashboard.bumex.mr
NEXT_PUBLIC_APP_URL=https://dashboard.bumex.mr
NEXT_PUBLIC_SITE_URL=https://dashboard.bumex.mr
NEXT_PUBLIC_ENABLE_SELF_SIGNUP=0
ENABLE_SELF_SIGNUP=0
ENABLE_ENTITY_SCOPING=0
ENABLE_LOCAL_PREVIEW_AUTH=0
BUMEX_SUPER_ADMIN_EMAIL=admin@bumex.mr
CRON_SECRET=replace_with_a_long_random_secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="BUMEX IT Billing <billing@bumex.mr>"
# Notification emails go through Resend when RESEND_API_KEY is set, else Microsoft Graph, else SMTP.
# The sender must be on a domain verified in Resend (verify.bumex.mr).
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM="BUMEX Dashboard <notifications@verify.bumex.mr>"
NOTIFICATION_EMAIL_SENDER_EMAIL=bumex@bumex.mr
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
BUMEX_BILLING_COMPANY=BUMEX IT
BUMEX_BILLING_ADDRESS=Head Office
BUMEX_BILLING_CITY=Nouakchott
BUMEX_BILLING_COUNTRY=Mauritania
BUMEX_BILLING_EMAIL=billing@bumex.mr
BUMEX_BILLING_PHONE=+222 00 00 00 00
BUMEX_BILLING_WEBSITE=https://bumex.mr
BUMEX_BILLING_TAX_ID=N/A
BUMEX_BILLING_BANK_NAME=Your Bank
BUMEX_BILLING_ACCOUNT_OWNER=BUMEX IT
BUMEX_BILLING_IBAN=MR00 0000 0000 0000 0000 0000 000
BUMEX_BILLING_BIC=BANKMRMRXXX
BUMEX_BILLING_ADDRESS_LINE_2=Optional second address line
BUMEX_BILLING_CAPITAL=Capital information
BUMEX_BILLING_FOOTER=Optional invoice footer
