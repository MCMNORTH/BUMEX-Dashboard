{
  "firestore": [
    {
      "database": "bumex",
      "rules": "firebase/firestore.rules",
      "indexes": "firebase/firestore.indexes.json"
    }
  ],
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    }
  },
  "apphosting": [
    {
      "backendId": "bumex-dashboard",
      "rootDir": "/",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        ".firebase",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "firestore-debug.log",
        ".env",
        ".env.*",
        "*-service-account*.json",
        "supabase"
      ]
    }
  ]
}
