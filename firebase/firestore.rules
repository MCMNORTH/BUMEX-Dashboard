rules_version = '2';

// All data access goes through the Next.js server with the Admin SDK, which
// bypasses these rules and enforces row policies in lib/firebase/policies.ts.
// Browsers must never read or write Firestore directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
